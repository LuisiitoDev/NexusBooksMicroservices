@page "/"
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<h1>NexusBooks microservices client</h1>

<p>
    Use this client to manage authors, manage books, browse the catalog, and purchase a book through the shopping cart service.
</p>

<section>
    <h2>Quick links</h2>
    <ul>
        <li><a href="/authors">Feed the authors database</a></li>
        <li><a href="/books">Feed the books database</a></li>
        <li><a href="/shopping-cart">Purchase a book</a></li>
    </ul>
</section>

<section>
    <h2>Workflow</h2>
    <ol>
        <li>Create authors first.</li>
        <li>Create books and assign one or more authors.</li>
        <li>Select a book and create a shopping cart purchase.</li>
    </ol>
</section>
